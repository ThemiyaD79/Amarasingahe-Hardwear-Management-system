<Window x:Class="HardwareManagementSystem.CashierDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cashier Terminal - Amarasinghe Hardware" Height="768" Width="1200" 
        Background="#F1F5F9" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B" BorderThickness="0">
            <Grid>
                <StackPanel Margin="15,20,15,0">

                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,30">
                        <Image Source="/Images/logo.png" Height="70" Width="70" Margin="0,0,0,10" Stretch="Uniform"/>
                        <TextBlock Text="A. Hardware" FontWeight="ExtraBold" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Home" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" HorizontalAlignment="Left" FontSize="15" Margin="10,8" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="Add to cart" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" HorizontalAlignment="Left" FontSize="15" Margin="10,8" Cursor="Hand" FontWeight="SemiBold"/>

                    <Border Height="1" Background="#334155" Margin="0,20"/>
                    <TextBlock Text="CATEGORIES" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" Margin="10,0,0,10"/>

                    <Button Content="All Categories" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="#CBD5E1" Cursor="Hand" Margin="15,6" Click="Category_Click"/>
                    <Button Content="Generators" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="#CBD5E1" Cursor="Hand" Margin="15,6" Click="Category_Click"/>
                    <Button Content="Bush Cutters" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="#CBD5E1" Cursor="Hand" Margin="15,6" Click="Category_Click"/>
                    <Button Content="Ladders" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="#CBD5E1" Cursor="Hand" Margin="15,6" Click="Category_Click"/>
                </StackPanel>

                <Button Content="Logout" VerticalAlignment="Bottom" Margin="20,20,20,30" Background="#EF4444" Foreground="White" Padding="10,12" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Switch To Room" Background="#E0F2FE" Foreground="#0284C7" Padding="15,8" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <TextBlock Text="Date: Today" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text=" | Logged in as: " Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtCurrentUserName" Text="Cashier" VerticalAlignment="Center" Foreground="#0F172A" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="5" Background="White">
                            <TextBox x:Name="TxtProductSearch" Width="300" Padding="10,8" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="Search products..."/>
                        </Border>
                        <Button Content="Search" Background="#0EA5E9" Foreground="White" Padding="20,0" BorderThickness="0" Margin="10,0,0,0" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl x:Name="IcProducts">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="220" ItemHeight="260" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Margin="10"/>
                                    </Border>

                                    <Border Grid.Row="0" Background="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="8,4" CornerRadius="5">
                                        <TextBlock Text="{Binding StockLeft, StringFormat='{}Stock: {0}'}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <Border Grid.Row="0" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="10,5" CornerRadius="5">
                                        <TextBlock Text="{Binding SellingPrice, StringFormat='LKR {0:N2}'}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding ProductName}" Foreground="#334155" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <Button Grid.Row="2" Content="Add to Cart" CommandParameter="{Binding}" Click="BtnAddProduct_Click" Background="#EFF6FF" Foreground="#2563EB" Margin="0,10,0,0" Padding="8" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Current Order" FontWeight="Bold" FontSize="18" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Content="Clear Order" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="12,6" HorizontalAlignment="Right" Cursor="Hand" Click="BtnClearOrder_Click" FontWeight="Bold"/>
                </Grid>

                <DataGrid x:Name="DgdCart" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="40">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="Auto"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="Auto"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,15">
                    <StackPanel>
                        <Grid Margin="0,4">
                            <TextBlock Text="Sub Total :" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSubTotal" Text="0.00" HorizontalAlignment="Right" Foreground="#475569" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Discount :" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtDiscount" Text="0.00" HorizontalAlignment="Right" Foreground="#475569" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="1" Background="#E2E8F0" Margin="0,10"/>
                        <Grid Margin="0,4">
                            <TextBlock Text="TOTAL :" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A"/>
                            <TextBlock x:Name="TxtTotal" Text="0.00" HorizontalAlignment="Right" FontWeight="ExtraBold" FontSize="18" Foreground="#0EA5E9"/>
                        </Grid>

                        <Grid Margin="0,15,0,4">
                            <TextBlock Text="CASH GIVEN :" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCash" Width="120" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#0F172A" FontWeight="Bold" FontSize="14" Padding="4" BorderBrush="#CBD5E0" TextChanged="TxtCash_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="CHANGE :" Foreground="#64748B" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtChange" Text="0.00" HorizontalAlignment="Right" Foreground="#10B981" FontWeight="ExtraBold" FontSize="16"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Height="100" Margin="0,0,0,15">
                    <TextBlock Text="Numpad Interface" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#94A3B8"/>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="SAVE TO DEBTOR" Background="#3B82F6" Foreground="White" Height="65" Margin="0,0,4,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveOrder_Click"/>
                    <Button Grid.Column="1" Content="CASH PAY NOW" Background="#10B981" Foreground="White" Height="65" Margin="4,0,0,0" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnPay_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="DebtorOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="105">
            <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="CREDIT SALE (DEBTOR DETAILS)" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Debtor Name:" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDebtorName" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,15" FontSize="14"/>

                    <TextBlock Text="Phone Number (Required):" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDebtorPhone" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,15" FontSize="14"/>

                    <TextBlock Text="Address:" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDebtorAddress" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,25" FontSize="14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCancelCredit_Click"/>
                        <Button Grid.Column="1" Content="Confirm Credit" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnConfirmCredit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ReceiptOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <Border x:Name="ReceiptPaper" Background="White" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="AMARASINGHE HARDWARE" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center" Foreground="#0F172A"/>
                    <TextBlock Text="123 Main Street, Ja-Ela, Sri Lanka" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,2,0,0"/>
                    <TextBlock Text="Tel: +94 77 123 4567" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Receipt No:" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtReceiptBillID" Text="10045" HorizontalAlignment="Right" Foreground="#0F172A"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Date/Time:" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtReceiptDate" Text="04/05/2026 14:30" HorizontalAlignment="Right" Foreground="#0F172A"/>
                    </Grid>

                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="4 2" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Item" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Qty" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Total" FontWeight="Bold" TextAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="IcReceiptItems" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:N2}}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="4 2" Margin="0,10"/>

                    <Grid Margin="0,3">
                        <TextBlock Text="Net Total:" Foreground="#475569"/>
                        <TextBlock x:Name="TxtReceiptTotal" Text="0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="Payment Type:" Foreground="#475569"/>
                        <TextBlock x:Name="TxtReceiptCash" Text="0.00" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="Change Due:" Foreground="#475569"/>
                        <TextBlock x:Name="TxtReceiptChange" Text="0.00" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>

                    <TextBlock Text="Thank you for your business!" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,30,0,20"/>

                    <Grid x:Name="ReceiptActionGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Print Receipt" Background="#0EA5E9" Foreground="White" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnPrintReceipt_Click"/>
                        <Button Grid.Column="1" Content="Close &amp; Next" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseReceipt_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>