<Window x:Class="HardwareManagementSystem.CashierDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cashier Terminal - Amarasinghe Hardware" Height="800" Width="1280" 
        Background="#F8FAFC" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <Style x:Key="SizeTileStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- UPDATED LEFT SIDE PANEL -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <!-- Using a Grid to properly manage available height and anchor the bottom button -->
            <Grid Margin="20,25,20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Reset Button -->
                    <RowDefinition Height="Auto"/>
                    <!-- Category Header -->
                    <RowDefinition Height="*"/>
                    <!-- Category Filter List (Stretches to fill room) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Logout Button -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,30">
                    <TextBlock Text="Amarasinghe" FontWeight="ExtraBold" FontSize="26" Foreground="#0EA5E9" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hardware" FontWeight="Bold" FontSize="16" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                </StackPanel>

                <Button Grid.Row="1" Content="Reset All Filters" Background="#F8FAFC" BorderThickness="1" BorderBrush="#CBD5E0" Foreground="#0F172A" HorizontalAlignment="Stretch" Padding="10" FontSize="14" Margin="0,0,0,25" Cursor="Hand" FontWeight="Bold" Click="BtnResetFilters_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Border Grid.Row="2" Background="#F1F5F9" Padding="10,6" CornerRadius="6" Margin="0,0,0,10">
                    <TextBlock Text="FILTER BY CATEGORY" FontWeight="ExtraBold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" BorderThickness="0">
                    <StackPanel x:Name="SpCategories" Margin="5,0,5,0" />
                </ScrollViewer>

                <Button Grid.Row="4" Content="Logout" Background="#FEF2F2" Foreground="#DC2626" Padding="10,12" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnLogout_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Switch To Manager" Background="#E0F2FE" Foreground="#0284C7" Padding="15,8" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSwitchToManager_Click"/>
                        <TextBlock Text="Date: Today" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text=" | Logged in as: " Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtCurrentUserName" Text="Cashier" VerticalAlignment="Center" Foreground="#0F172A" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="5" Background="White">
                            <TextBox x:Name="TxtProductSearch" Width="400" Padding="10,8" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="Search products..." TextChanged="TxtProductSearch_TextChanged" GotFocus="TxtProductSearch_GotFocus" LostFocus="TxtProductSearch_LostFocus" KeyDown="TxtProductSearch_KeyDown"/>
                        </Border>

                        <Button Grid.Column="2" Content="+ Add Manual Item" Background="#10B981" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenManualItem_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl x:Name="IcProducts" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="220" ItemHeight="280" HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Margin="10"/>
                                    </Border>

                                    <Border Grid.Row="0" Background="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="8,4" CornerRadius="5">
                                        <TextBlock Text="{Binding TotalQuantity, StringFormat='{}Stock: {0:0.##}'}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <Border Grid.Row="0" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="10,5" CornerRadius="5">
                                        <TextBlock Text="{Binding CurrentSellingPrice, StringFormat='LKR {0:N2}'}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#334155" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="{Binding SellingUnit, StringFormat='{}Per {0}'}" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                    <Button Grid.Row="3" Content="Add to Cart" CommandParameter="{Binding}" Click="BtnAddProduct_Click" Background="#EFF6FF" Foreground="#2563EB" Padding="8" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="20" Panel.ZIndex="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Current Order" FontWeight="Bold" FontSize="18" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Content="Clear Order" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="12,6" HorizontalAlignment="Right" Cursor="Hand" Click="BtnClearOrder_Click" FontWeight="Bold"/>
                </Grid>

                <DataGrid x:Name="DgdCart" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="45">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="40"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Edit" Foreground="#3B82F6" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnEditCartItem_Click" Margin="0,0,8,0" FontWeight="Bold"/>
                                        <Button Content="X" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnRemoveCartItem_Click" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,15">
                    <StackPanel>
                        <Grid Margin="0,4">
                            <TextBlock Text="Items Sub Total :" Foreground="#64748B" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSubTotal" Text="0.00" HorizontalAlignment="Right" Foreground="#475569" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Line Item Discounts :" Foreground="#64748B" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtItemDiscounts" Text="0.00" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,8">
                            <TextBlock Text="Additional Bill Disc (LKR) :" Foreground="#64748B" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="TxtBillDiscount" Width="100" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#EF4444" FontWeight="Bold" FontSize="14" Padding="4" BorderBrush="#CBD5E0" Text="0" TextChanged="TxtBillDiscount_TextChanged"/>
                        </Grid>
                        <Border Height="1" Background="#E2E8F0" Margin="0,10"/>
                        <Grid Margin="0,4">
                            <TextBlock Text="GRAND TOTAL :" FontWeight="ExtraBold" FontSize="16" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotal" Text="0.00" HorizontalAlignment="Right" FontWeight="ExtraBold" FontSize="20" Foreground="#0EA5E9"/>
                        </Grid>
                        <Grid Margin="0,20,0,4">
                            <TextBlock Text="CASH GIVEN :" Foreground="#64748B" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="TxtCash" Width="120" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#0F172A" FontWeight="Bold" FontSize="14" Padding="4" BorderBrush="#CBD5E0" TextChanged="TxtCash_TextChanged"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="CHANGE :" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtChange" Text="0.00" HorizontalAlignment="Right" Foreground="#10B981" FontWeight="ExtraBold" FontSize="18"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="SAVE TO DEBTOR" Background="#3B82F6" Foreground="White" Height="60" Margin="0,0,4,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveOrder_Click"/>
                    <Button Grid.Column="1" Content="CASH PAY NOW" Background="#10B981" Foreground="White" Height="60" Margin="4,0,0,0" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnPay_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="AddToCartOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="300">
            <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="12">
                <StackPanel>
                    <TextBlock x:Name="TxtAddProductName" Text="Product Name" FontWeight="ExtraBold" FontSize="20" Foreground="#0F172A" Margin="0,0,0,10" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                    <StackPanel x:Name="SpVariantSelector" Margin="0,10,0,15" Visibility="Collapsed">
                        <TextBlock Text="Select Size / Variant:" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <ListBox x:Name="LbxVariantSelect" BorderThickness="0" Background="Transparent" SelectionChanged="LbxVariantSelect_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="Margin" Value="5"/>
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#0EA5E9"/>
                                                        <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ShortName}" FontSize="14" FontWeight="Bold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Grid Margin="0,0,0,20">
                        <TextBlock x:Name="TxtAddProductStock" Text="Stock: 0" Foreground="#64748B" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAddProductPrice" Text="LKR 0.00" Foreground="#10B981" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Quantity:" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="6" Margin="0,0,15,0" Background="#FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnDecreaseQty" Content="-" Width="45" Height="45" Background="#F8FAFC" Foreground="#475569" BorderThickness="0,0,1,0" BorderBrush="#CBD5E0" FontSize="24" FontWeight="Bold" Cursor="Hand" Click="BtnDecreaseQty_Click"/>
                                <TextBox x:Name="TxtAddQuantity" Width="70" Height="45" Background="Transparent" BorderThickness="0" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1"/>
                                <Button x:Name="BtnIncreaseQty" Content="+" Width="45" Height="45" Background="#F8FAFC" Foreground="#475569" BorderThickness="1,0,0,0" BorderBrush="#CBD5E0" FontSize="24" FontWeight="Bold" Cursor="Hand" Click="BtnIncreaseQty_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtAddUnit" Text="Unit" VerticalAlignment="Center" FontWeight="ExtraBold" FontSize="16" Foreground="#0F172A"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Click="BtnCancelAdd_Click" Background="#E2E8F0" Foreground="#475569" Padding="12" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Add To Cart" Click="BtnConfirmAdd_Click" Background="#3B82F6" Foreground="White" Padding="12" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EditCartItemOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="310">
            <Border Background="White" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="12">
                <StackPanel>
                    <TextBlock x:Name="TxtEditProductName" Text="Product Name" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,20" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBlock Text="Override Unit Price (LKR):" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEditPrice" Padding="10" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Change Quantity:" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEditQuantity" Padding="10" FontSize="16" FontWeight="Bold" Margin="0,0,0,25"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Click="BtnCancelEdit_Click" Background="#E2E8F0" Foreground="#475569" Padding="12" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Save Changes" Click="BtnConfirmEdit_Click" Background="#F59E0B" Foreground="White" Padding="12" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ManualItemOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="320">
            <Border Background="White" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="ADD CUSTOM ITEM" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Temporary item for this bill only" Foreground="#64748B" FontSize="12" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Item Name/Description:" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtManualItemName" Padding="10" FontSize="14" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Unit Price (LKR):" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtManualItemPrice" Padding="10" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Quantity:" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtManualItemQuantity" Padding="10" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Selling Unit &amp; Size:" FontWeight="Bold" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbManualItemUnit" Grid.Column="0" Padding="8" SelectionChanged="CmbManualItemUnit_SelectionChanged" Margin="0,0,5,0">
                            <ComboBoxItem Content="Piece" IsSelected="True"/>
                            <ComboBoxItem Content="Meter"/>
                            <ComboBoxItem Content="Kg"/>
                            <ComboBoxItem Content="Liter"/>
                        </ComboBox>
                        <StackPanel x:Name="SpManualItemSize" Grid.Column="1" Margin="5,0,0,0" Visibility="Collapsed">
                            <ComboBox x:Name="CmbManualItemSize" IsEditable="True" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Click="BtnCancelManualItem_Click" Background="#E2E8F0" Foreground="#475569" Padding="12" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Add To Order" Click="BtnConfirmManualItem_Click" Background="#10B981" Foreground="White" Padding="12" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DebtorOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="105">
            <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="CREDIT SALE (DEBTOR DETAILS)" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Debtor Name:" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDebtorName" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,15" FontSize="14"/>
                    <TextBlock Text="Phone Number (Required):" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDebtorPhone" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,15" FontSize="14"/>
                    <TextBlock Text="Address:" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDebtorAddress" Padding="8" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,25" FontSize="14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCancelCredit_Click"/>
                        <Button Grid.Column="1" Content="Confirm Credit" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnConfirmCredit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ReceiptOverlay" Grid.ColumnSpan="3" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <Border x:Name="ReceiptPaper" Background="White" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="AMARASINGHE HARDWARE" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center" Foreground="#0F172A"/>
                    <TextBlock Text="123 Main Street, Ja-Ela, Sri Lanka" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,2,0,0"/>
                    <TextBlock Text="Tel: +94 77 123 4567" FontSize="12" HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Receipt No:" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtReceiptBillID" Text="10045" HorizontalAlignment="Right" Foreground="#0F172A"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Date/Time:" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtReceiptDate" Text="04/05/2026 14:30" HorizontalAlignment="Right" Foreground="#0F172A"/>
                    </Grid>
                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="4 2" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Item" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Qty" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Total" FontWeight="Bold" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl x:Name="IcReceiptItems" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:0.##}}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:N2}}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="4 2" Margin="0,10"/>
                    <Grid Margin="0,3">
                        <TextBlock Text="Items Sub Total:" Foreground="#475569"/>
                        <TextBlock x:Name="TxtReceiptSubTotal" Text="0.00" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="Saved from Item Edits:" Foreground="#EF4444"/>
                        <TextBlock x:Name="TxtReceiptItemDiscounts" Text="0.00" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="Additional Bill Discount:" Foreground="#EF4444"/>
                        <TextBlock x:Name="TxtReceiptDiscount" Text="0.00" HorizontalAlignment="Right" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </Grid>
                    <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="4 2" Margin="0,10"/>
                    <Grid Margin="0,3">
                        <TextBlock Text="GRAND TOTAL:" Foreground="#0F172A" FontWeight="ExtraBold" FontSize="16"/>
                        <TextBlock x:Name="TxtReceiptTotal" Text="0.00" HorizontalAlignment="Right" FontWeight="ExtraBold" FontSize="18"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="Payment Info:" Foreground="#475569"/>
                        <TextBlock x:Name="TxtReceiptCash" Text="CASH" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <TextBlock Text="Change Due:" Foreground="#475569"/>
                        <TextBlock x:Name="TxtReceiptChange" Text="0.00" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock Text="Thank you for your business!" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,30,0,20"/>
                    <Grid x:Name="ReceiptActionGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Print Receipt" Background="#0EA5E9" Foreground="White" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnPrintReceipt_Click"/>
                        <Button Grid.Column="1" Content="Close &amp; Next" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseReceipt_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>