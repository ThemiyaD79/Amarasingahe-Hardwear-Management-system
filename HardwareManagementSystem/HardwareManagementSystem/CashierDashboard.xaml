<Window x:Class="HardwareManagementSystem.CashierDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cashier Dashboard - Amarasinghe Hardware" Height="768" Width="1024" 
        Background="White" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,2,0">
            <Grid>
                <StackPanel Margin="15,20,15,0">
                    <TextBlock Text="A. Hardware" FontWeight="Bold" FontSize="18" Foreground="#2C5282" Margin="0,0,0,20"/>
                    <Button Content="Home" Background="Transparent" BorderThickness="0" Foreground="#2B6CB0" HorizontalAlignment="Left" FontSize="14" Margin="0,5" Cursor="Hand"/>
                    <Button Content="Add to cart" Background="Transparent" BorderThickness="0" Foreground="#2B6CB0" HorizontalAlignment="Left" FontSize="14" Margin="0,5" Cursor="Hand"/>
                    <Button Content="Update Items" Background="Transparent" BorderThickness="0" Foreground="#2B6CB0" HorizontalAlignment="Left" FontSize="14" Margin="0,5" Cursor="Hand"/>

                    <TextBlock Text="Categories" FontWeight="Bold" Foreground="#4A5568" Margin="0,20,0,10"/>
                    <TextBlock Text="• Generators" Foreground="#718096" Margin="10,5"/>
                    <TextBlock Text="• Bush Cutters" Foreground="#718096" Margin="10,5"/>
                    <TextBlock Text="• Ladders" Foreground="#718096" Margin="10,5"/>
                </StackPanel>
                <Button Content="Logout" VerticalAlignment="Bottom" Margin="15" Background="#4A90E2" Foreground="White" Padding="10,10" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F7FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Switch To Room" Background="#4A90E2" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <TextBlock Text="Date: Today" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#4A5568" FontWeight="SemiBold"/>

                        <TextBlock Text=" | Logged in as: " Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#4A5568"/>
                        <TextBlock x:Name="TxtCurrentUserName" Text="Admin" VerticalAlignment="Center" Foreground="#2C5282" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBox x:Name="TxtProductSearch" Width="250" Padding="10" Background="#EDF2F7" BorderBrush="#CBD5E0" BorderThickness="1" VerticalContentAlignment="Center" Text="Hinted search text..."/>
                        <Button Content="Search" Background="#4A90E2" Foreground="White" Padding="15,0" BorderThickness="0" Margin="10,0,0,0" FontWeight="Bold" Cursor="Hand"/>

                        <ComboBox Width="120" Margin="10,0,0,0" Padding="5" VerticalContentAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="All Items"/>
                            <ComboBoxItem Content="Price: Low to High"/>
                            <ComboBoxItem Content="Price: High to Low"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <WrapPanel x:Name="WrpProductCards" ItemWidth="200" ItemHeight="240">

                    <Border Background="White" CornerRadius="12" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#EDF2F7" CornerRadius="12,12,0,0" Margin="1"/>
                            <Border Grid.Row="0" Background="#A0AEC0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4" CornerRadius="5">
                                <TextBlock Text="LKR 2000" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Button Grid.Row="1" Content="Generator Model X" Background="#4A90E2" Foreground="White" Margin="15" Padding="5" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <Border Background="White" CornerRadius="12" Margin="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#EDF2F7" CornerRadius="12,12,0,0" Margin="1"/>
                            <Border Grid.Row="0" Background="#A0AEC0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,4" CornerRadius="5">
                                <TextBlock Text="LKR 4500" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Button Grid.Row="1" Content="Heavy Ladder" Background="#4A90E2" Foreground="White" Margin="15" Padding="5" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                </WrapPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="2,0,0,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" AutoGenerateColumns="False" HeadersVisibility="Column" Background="White" BorderThickness="0" GridLinesVisibility="None" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Width="*"/>
                        <DataGridTextColumn Header="Price" Width="Auto"/>
                        <DataGridTextColumn Header="QTY" Width="Auto"/>
                        <DataGridTextColumn Header="Total" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#E2E8F0" CornerRadius="10" Padding="15" Margin="0,15">
                    <StackPanel>
                        <Grid Margin="0,3">
                            <TextBlock Text="SUB TOTAL :" Foreground="#2C5282"/>
                            <TextBlock Text="0.00" HorizontalAlignment="Right" Foreground="#2C5282"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="ADD DISCOUNT :" Foreground="#2C5282"/>
                            <TextBlock Text="0.00" HorizontalAlignment="Right" Foreground="#2C5282"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="TOTAL :" FontWeight="Bold" Foreground="#2C5282"/>
                            <TextBlock Text="0.00" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#2C5282"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="CASH :" Foreground="#2C5282"/>
                            <TextBlock Text="0.00" HorizontalAlignment="Right" Foreground="#2C5282"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="DUE :" Foreground="#2C5282"/>
                            <TextBlock Text="0.00" HorizontalAlignment="Right" Foreground="#2C5282"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#EDF2F7" CornerRadius="10" Height="100" Margin="0,0,0,15">
                    <TextBlock Text="Keypad" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="#4A5568"/>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="DELETE&#x0a;ORDER" Background="#4A90E2" Foreground="White" Height="60" Margin="2" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="1" Content="SAVE&#x0a;ORDER" Background="#4A90E2" Foreground="White" Height="60" Margin="2" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="PRINT" Background="#2C5282" Foreground="White" Height="60" Margin="2" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>