<Window x:Class="HardwareManagementSystem.InventoryManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Management - Amarasinghe Hardware" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#111827">

    <Window.Resources>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1F2937"/>
            <Setter Property="AlternatingRowBackground" Value="#374151"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="Height" Value="45"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="MANAGEMENT / INVENTORY" Foreground="#9CA3AF" FontSize="12"/>
            <TextBlock Text="Inventory Items" Foreground="White" FontSize="28" FontWeight="Bold"/>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnAddItem" Content="+ Add New Item" Width="150" Height="40" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Margin="0,0,10,0" Click="btnAddItem_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnUpdateItem" Content="Update Selected" Width="150" Height="40" 
                        Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Margin="0,0,10,0" Click="btnUpdateItem_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnDeleteItem" Content="Delete Selected" Width="150" Height="40" 
                        Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Click="btnDeleteItem_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Filters -->
            <TextBlock Grid.Column="3" Text="Category:" Foreground="#9CA3AF" FontSize="14" 
                       VerticalAlignment="Top" Margin="46,-24,61,0"/>

            <ComboBox x:Name="cmbCategoryFilter" Grid.Column="3" Width="150" Height="40" 
                      Margin="0,0,15,0" FontSize="14" VerticalContentAlignment="Center"/>

            <!-- Search & View All -->
            <TextBox x:Name="txtSearch" Grid.Column="4" Width="200" Height="40" Background="#374151" 
                     Foreground="White" FontSize="14" BorderThickness="0" 
                     VerticalContentAlignment="Center" Padding="10,0,0,0"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnSearch" Content="Search" Width="80" Height="40" 
            Background="#6B7280" Foreground="White" BorderThickness="0" 
            Cursor="Hand" Margin="0,0,5,0" Click="btnSearch_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgInventory" Grid.Row="2" Style="{StaticResource ModernDataGrid}" 
                  AutoGenerateColumns="True" SelectionMode="Single"/>
        <Button x:Name="btnViewAll" Content="View All"
            Background="#3B82F6" Foreground="White" BorderThickness="0"
            Cursor="Hand" Click="btnViewAll_Click" RenderTransformOrigin="-5.999,0.562" Margin="480,78,548,20" Grid.RowSpan="2">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>