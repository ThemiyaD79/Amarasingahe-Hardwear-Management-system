                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="Selling Unit:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbSellingUnit" Padding="5" SelectionChanged="CmbSellingUnit_SelectionChanged">
                                        <ComboBoxItem Content="Piece" IsSelected="True"/>
                                        <ComboBoxItem Content="Meter"/>
                                        <ComboBoxItem Content="Kg"/>
                                        <ComboBoxItem Content="Liter"/>
                                        <ComboBoxItem Content="Can"/>
                                        <ComboBoxItem Content="Bucket"/>
                                        <ComboBoxItem Content="Packet"/>
                                    </ComboBox>
