                    <Button Content="Close" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,15,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseViewStaffModal_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="RestockModalOverlay" Grid.ColumnSpan="2" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="120">
