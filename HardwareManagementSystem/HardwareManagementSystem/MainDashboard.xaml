                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Update Selling Price (Per Unit):" FontWeight="Bold" FontSize="11" Foreground="#10B981"/>
                                    <TextBox x:Name="TxtRestockSellingPrice" Padding="5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseRestock_Click"/>
                        <Button Grid.Column="1" Content="Save Stock" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveRestock_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SupplierStockModalOverlay" Grid.ColumnSpan="2" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="160">
            <Border Background="White" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="TxtStockModalSupplierName" Text="Stock from: Supplier" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <DataGrid x:Name="DgdSupplierStock" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#1A000000" IsReadOnly="True" RowHeight="35" Height="250" Margin="0,0,0,20">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource AppBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,12"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Stock Left" Binding="{Binding TotalStockLeft}" Width="100"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding SellingUnit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Close" Background="#E2E8F0" Foreground="#475569" Padding="10" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseSupplierStock_Click" HorizontalAlignment="Center" Width="100"/>
                </StackPanel>
            </Border>
        </Grid>

