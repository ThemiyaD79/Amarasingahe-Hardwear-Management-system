                                </StackPanel>
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="BATCH DETAILS (Revenue Tracking)" FontWeight="ExtraBold" FontSize="10" Foreground="#0EA5E9" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Supplier:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                            <ComboBox x:Name="CmbInvSupplier" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID" Padding="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Payment Method:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                            <ComboBox x:Name="CmbInvPaymentType" Padding="5">
                                                <ComboBoxItem Content="Cash" IsSelected="True"/>
                                                <ComboBoxItem Content="Credit (Add to Debt)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Batch Number:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtBatchNumber" Padding="5" Margin="0,0,0,5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Purchase Qty:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtBatchQty" Padding="5" Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Cost Price (Per Unit):" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtCostPrice" Padding="5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Selling Price (Per Unit):" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtInvPrice" Padding="5"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Sub-Category:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtInvSubCategory" Padding="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Brand:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                                    <TextBox x:Name="TxtInvBrand" Padding="5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Product Image" FontWeight="Bold" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
