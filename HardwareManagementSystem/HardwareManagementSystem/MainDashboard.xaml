<Window x:Class="HardwareManagementSystem.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Dashboard - Amarasinghe Hardware" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#111827">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937" Padding="15">
            <StackPanel>
                <TextBlock Text="A. Hardware" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,10,0,40"/>

                <Button Content="Home" Style="{StaticResource SidebarButton}" x:Name="btnHomeNav"/>
                <Button Content="Staff" Style="{StaticResource SidebarButton}" x:Name="btnStaffNav"/>
                <Button Content="Inventory" Style="{StaticResource SidebarButton}" x:Name="btnInventoryNav" Click="btnInventoryNav_Click"/>
                <Button Content="Sales" Style="{StaticResource SidebarButton}" x:Name="btnSalesNav"/>
                <Button Content="Reports" Style="{StaticResource SidebarButton}" x:Name="btnReportsNav"/>
                <Button Content="Settings" Style="{StaticResource SidebarButton}" x:Name="btnSettingsNav"/>

                <Button Content="Logout" Background="#4B5563" Foreground="White" BorderThickness="0" 
                        Margin="0,200,0,0" Padding="10" Click="btnLogout_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Welcome Back, Manager!" Foreground="White" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="OverView" Foreground="#9CA3AF" FontSize="18" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style x:Key="DashboardCard" TargetType="Border">
                        <Setter Property="Background" Value="#1F2937"/>
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="Padding" Value="20"/>
                    </Style>
                    <Style x:Key="CardTitle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                    </Style>
                    <Style x:Key="CardValue" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="24"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Grid.Resources>

                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="Total Staff" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="12" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="Total Items" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="1,250" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Grid.Row="0" Style="{StaticResource DashboardCard}" Background="#451a1a">
                    <StackPanel>
                        <TextBlock Text="Low Stock Items" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="5" Style="{StaticResource CardValue}" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource DashboardCard}" Grid.ColumnSpan="3">
                    <StackPanel>
                        <TextBlock Text="Today's Revenue (Rs)" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="155,750.00" Style="{StaticResource CardValue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource DashboardCard}" >
                    <TextBlock Text="Sales Graph Placeholder" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>