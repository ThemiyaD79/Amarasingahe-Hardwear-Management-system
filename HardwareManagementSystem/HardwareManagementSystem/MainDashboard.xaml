<Window x:Class="HardwareManagementSystem.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Dashboard - Amarasinghe Hardware" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3B82F6"/>
                                <Setter Property="Foreground" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="BorderBrush" Value="#1A000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F4EFF8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                    <TextBlock Text="Amarasinghe" FontWeight="ExtraBold" FontSize="26" Foreground="#0EA5E9" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hardware" FontWeight="Bold" FontSize="16" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Main Menu" Foreground="#6B7280" FontSize="13" FontWeight="Bold" Margin="25,10,0,10"/>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnHomeNav" Click="btnHomeNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2.01 3L2 10l15 2-15 2 .01 7L23 12 2.01 3z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnSalesNav" Click="btnSalesNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12.1 18.55L12 18.65L11.89 18.55C7.14 14.24 4 11.39 4 8.5C4 6.5 5.5 5 7.5 5C9.04 5 10.54 6 11.07 7.36H12.93C13.46 6 14.96 5 16.5 5C18.5 5 20 6.5 20 8.5C20 11.39 16.86 14.24 12.1 18.55ZM16.5 3C14.76 3 13.09 3.81 12 5.08C10.91 3.81 9.24 3 7.5 3C4.42 3 2 5.41 2 8.5C2 12.27 5.4 15.36 10.55 20.03L12 21.35L13.45 20.03C18.6 15.36 22 12.27 22 8.5C22 5.41 19.58 3 16.5 3Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Sales History" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Business" Foreground="#6B7280" FontSize="13" FontWeight="Bold" Margin="25,20,0,10"/>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnDebtorsNav" Click="btnDebtorsNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Debtors" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnInventoryNav" Click="btnInventoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Inventory" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnSuppliersNav" Click="btnSuppliersNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Suppliers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Administration" Foreground="#6B7280" FontSize="13" FontWeight="Bold" Margin="25,20,0,10"/>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnStaffNav" Click="btnStaffNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Staff Management" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnReportsNav" Click="btnReportsNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Reports" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}" x:Name="btnSettingsNav" Click="btnSettingsNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,15,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,20" VerticalAlignment="Bottom">
                    <Border Height="1" Background="#D1D5DB" Margin="25,0,25,15"/>
                    <Button Style="{StaticResource SidebarButton}" x:Name="btnCashierNav" Click="btnCashierNav_Click">
                        <TextBlock Text="Cashier Terminal" Foreground="#2563EB" FontWeight="Bold"/>
                    </Button>

                    <Button x:Name="btnLogout" Click="btnLogout_Click" Background="#F87171" Foreground="#7F1D1D" BorderThickness="0" Margin="25,15,25,0" Padding="0,12" FontWeight="Bold" Cursor="Hand" FontSize="15">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Logout"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">

            <Grid x:Name="TabOverview" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtWelcomeMessage" Text="Welcome Back, Manager!" Foreground="{DynamicResource TextMain}" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Store Performance Overview" Foreground="{DynamicResource TextMuted}" FontSize="16" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Padding="10">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="28"/>
                            <Border Background="#EF4444" CornerRadius="10" MinWidth="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0">
                                <TextBlock x:Name="TxtNotificationCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Total Accounts Payable" Style="{StaticResource CardTitle}" Foreground="#DC2626"/>
                            <TextBlock x:Name="TxtTotalPayable" Text="LKR 0.00" Style="{StaticResource CardValue}" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Total Physical Items in Stock" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="TxtTotalItems" Text="0" Style="{StaticResource CardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource DashboardCard}" Background="#FEF2F2" BorderBrush="#FECACA">
                        <StackPanel>
                            <TextBlock Text="Low Stock Alerts" Style="{StaticResource CardTitle}" Foreground="#DC2626"/>
                            <TextBlock x:Name="TxtLowStock" Text="0 Items" Style="{StaticResource CardValue}" Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Today's Total Revenue" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="TxtTodayRevenue" Text="LKR 0.00" Style="{StaticResource CardValue}" Foreground="#10B981"/>
                                <ProgressBar x:Name="ProgDailyGoal" Height="8" Margin="0,15,0,5" Foreground="#10B981" Background="#E2E8F0" BorderThickness="0"/>
                                <TextBlock x:Name="TxtGoalProgress" Text="0% of Daily Target" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource AppBg}" BorderBrush="#1A000000" BorderThickness="1" CornerRadius="8" Margin="0,20,0,0" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Current Inventory Status" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                                    <DataGrid Grid.Row="1" x:Name="DgdHomeInventory" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A000000" RowBackground="Transparent" Foreground="{DynamicResource TextMain}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Available Qty" Binding="{Binding TotalQuantity}" Width="100"/>
                                            <DataGridTextColumn Header="Unit" Binding="{Binding SellingUnit}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Critical Low Stock Alerts" Style="{StaticResource CardTitle}" Foreground="#DC2626"/>
                                <TextBlock x:Name="TxtTotalTransactions" Visibility="Collapsed"/>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgdLowStock" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A000000" IsReadOnly="True" RowHeight="35" Margin="0,10,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Left" Binding="{Binding TotalQuantity}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Action" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Restock" Background="#3B82F6" Foreground="White" Padding="5,2" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenRestock_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="TabDebtors" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Debtor Management" FontWeight="ExtraBold" FontSize="32" Foreground="{DynamicResource TextMain}"/>
                </Grid>
                <DataGrid x:Name="DgdDebtors" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#1A000000" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A000000" RowBackground="{DynamicResource CardBg}" AlternatingRowBackground="{DynamicResource AppBg}" IsReadOnly="True" RowHeight="45" Foreground="{DynamicResource TextMain}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource AppBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding DebtorID}" Width="80"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                        <DataGridTextColumn Header="Outstanding Balance" Binding="{Binding TotalOutstandingAmount, StringFormat='LKR {0:N2}'}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Pay Now" Background="#10B981" Foreground="White" Padding="10,5" Margin="5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenSettleDebt_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabSales" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Sales History" FontWeight="ExtraBold" FontSize="32" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="From:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" Margin="0,0,10,0"/>
                        <DatePicker x:Name="DpSalesFrom" Width="110" Margin="0,0,10,0"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" Margin="0,0,10,0"/>
                        <DatePicker x:Name="DpSalesTo" Width="110" Margin="0,0,20,0"/>
                        <Button Content="Search" Background="#3B82F6" Foreground="White" Padding="15,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnFilterSalesHistory_Click" Margin="0,0,20,0"/>
                        <TextBlock Text="Cashier:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbStaffFilter" Width="150" Padding="5" SelectionChanged="CmbStaffFilter_SelectionChanged"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdSales" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#1A000000" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A000000" RowBackground="{DynamicResource CardBg}" AlternatingRowBackground="{DynamicResource AppBg}" IsReadOnly="True" RowHeight="45" Foreground="{DynamicResource TextMain}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource AppBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill ID" Binding="{Binding BillID}" Width="80"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                        <DataGridTextColumn Header="Cashier" Binding="{Binding StaffName}" Width="150"/>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentType}" Width="100"/>
                        <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, StringFormat='LKR {0:N2}'}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View Bill" Background="#3B82F6" Foreground="White" Padding="10,5" Margin="5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnViewBill_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabStaff" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="System Users" FontWeight="ExtraBold" FontSize="32" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="+ Add New Staff" Background="#10B981" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnAddStaff_Click"/>
                        <Button Content="View Selected" Background="#0EA5E9" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnViewStaff_Click"/>
                        <Button Content="Update Selected" Background="#F59E0B" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnEditStaff_Click"/>
                        <Button Content="Delete Selected" Background="#EF4444" Foreground="White" Padding="15,10" Margin="0,0,20,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnDeleteStaff_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdStaff" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#1A000000" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A000000" RowBackground="{DynamicResource CardBg}" AlternatingRowBackground="{DynamicResource AppBg}" IsReadOnly="True" RowHeight="45" Foreground="{DynamicResource TextMain}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource AppBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StaffID}" Width="60"/>
                        <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
