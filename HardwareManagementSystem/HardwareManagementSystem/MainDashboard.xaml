                                    <TextBox x:Name="TxtRestockQty" Padding="5" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="New Cost Price (Per Unit):" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                                    <TextBox x:Name="TxtRestockCost" Padding="5"/>
