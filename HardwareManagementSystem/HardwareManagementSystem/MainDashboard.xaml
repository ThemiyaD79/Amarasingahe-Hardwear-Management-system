                    <TextBlock Text="Supplier &amp; Payment:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ComboBox x:Name="CmbRestockSupplier" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID" Padding="5" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbRestockPaymentType" Padding="5">
                                <ComboBoxItem Content="Cash" IsSelected="True"/>
                                <ComboBoxItem Content="Credit (Add to Debt)"/>
                            </ComboBox>
