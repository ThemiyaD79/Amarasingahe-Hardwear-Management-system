                                <Image x:Name="ImgProductPreview" Stretch="UniformToFill"/>
                            </Border>
                            <Button Content="Browse" Background="#E2E8F0" Foreground="#475569" Padding="10,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnBrowseImage_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Reorder Level:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtInvReorder" Padding="5" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkInvActive" Grid.Column="1" Content="Is Active?" VerticalAlignment="Bottom" FontWeight="Bold" IsChecked="True"/>
                    </Grid>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseInventoryModal_Click"/>
                        <Button Grid.Column="1" Content="Save Product" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveInventory_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="StaffModalOverlay" Grid.ColumnSpan="2" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="110">
            <Border Background="White" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="TxtStaffModalTitle" Text="ADD / EDIT STAFF" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HiddenStaffFormID" Visibility="Collapsed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Full Name:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtStaffFullName" Padding="5" Margin="0,0,0,10"/>
                            <TextBlock Text="Username:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtStaffUsername" Padding="5" Margin="0,0,0,10"/>
                            <TextBlock Text="Password:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <PasswordBox x:Name="TxtStaffPassword" Padding="5" Margin="0,0,0,10"/>
                            <TextBlock Text="Role:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <ComboBox x:Name="CmbStaffRole" Padding="5" Margin="0,0,0,10">
                                <ComboBoxItem Content="Cashier"/>
                                <ComboBoxItem Content="Manager"/>
                                <ComboBoxItem Content="Admin"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="NIC:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtStaffNIC" Padding="5" Margin="0,0,0,10"/>
                            <TextBlock Text="Phone:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtStaffPhone" Padding="5" Margin="0,0,0,10"/>
                            <TextBlock Text="Salary (LKR):" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtStaffSalary" Padding="5" Margin="0,0,0,10"/>
                            <TextBlock Text="Age:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBox x:Name="TxtStaffAge" Padding="5" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ChkStaffActive" Content="Is Account Active?" FontWeight="Bold" Margin="0,5,0,20" IsChecked="True"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseStaffModal_Click"/>
                        <Button Grid.Column="1" Content="Save Staff" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveStaff_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ViewStaffModalOverlay" Grid.ColumnSpan="2" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="115">
            <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="STAFF DETAILS" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Staff ID:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtViewStaffID" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Full Name:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtViewFullName" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Username:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtViewUsername" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Password Hash:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
