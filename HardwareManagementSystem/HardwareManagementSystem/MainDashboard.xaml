                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseRestock_Click"/>
                        <Button Grid.Column="1" Content="Save Stock" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveRestock_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SupplierStockModalOverlay" Grid.ColumnSpan="2" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="160">
            <Border Background="White" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="TxtStockModalSupplierName" Text="Stock from: Supplier" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <DataGrid x:Name="DgdSupplierStock" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" IsReadOnly="True" RowHeight="35" Height="250" Margin="0,0,0,20">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,12"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Stock Left" Binding="{Binding TotalStockLeft}" Width="100"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding SellingUnit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Close" Background="#E2E8F0" Foreground="#475569" Padding="10" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseSupplierStock_Click" HorizontalAlignment="Center" Width="100"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="QuickSupplierModalOverlay" Grid.ColumnSpan="2" Background="#CC0F172A" Visibility="Collapsed" Panel.ZIndex="170">
            <Border Background="White" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ADD NEW SUPPLIER" FontWeight="ExtraBold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="Supplier Name:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="TxtQuickSupplierName" Padding="5" Margin="0,0,0,10"/>
                    <TextBlock Text="Phone Number:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="TxtQuickSupplierPhone" Padding="5" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#E2E8F0" Foreground="#475569" Padding="8" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCancelQuickSupplier_Click"/>
                        <Button Grid.Column="1" Content="Save" Background="#3B82F6" Foreground="White" Padding="8" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveQuickSupplier_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsModalOverlay" Grid.ColumnSpan="2" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="300">
            <Border Background="White" Width="350" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SYSTEM SETTINGS" FontWeight="ExtraBold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Daily Revenue Goal (LKR):" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="TxtDailyGoal" Text="100000" Padding="8" Margin="0,5,0,20" FontSize="14"/>

                    <TextBlock Text="Application Theme:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                    <ComboBox x:Name="CmbTheme" Padding="8" Margin="0,5,0,20">
                        <ComboBoxItem Content="Light Mode" IsSelected="True"/>
                        <ComboBoxItem Content="Dark Mode"/>
                    </ComboBox>

                    <Button Content="💾 Create Database Backup" Background="#10B981" Foreground="White" Padding="10" Margin="0,0,0,20" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnBackupDB_Click"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Close" Background="#E2E8F0" Foreground="#475569" Padding="10" Margin="0,0,5,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnCloseSettings_Click"/>
                        <Button Grid.Column="1" Content="Save Settings" Background="#3B82F6" Foreground="White" Padding="10" Margin="5,0,0,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSaveSettings_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>