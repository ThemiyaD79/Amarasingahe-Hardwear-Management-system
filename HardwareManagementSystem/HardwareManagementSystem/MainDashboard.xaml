                        <Button Grid.Column="1" Content="+ New" Width="50" Margin="5,0,0,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnQuickAddSupplier_Click"/>
