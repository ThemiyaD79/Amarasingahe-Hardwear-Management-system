                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="NIC:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtViewNIC" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Phone:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtViewPhone" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Salary (LKR):" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtViewSalary" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Age:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtViewAge" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Status:" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
