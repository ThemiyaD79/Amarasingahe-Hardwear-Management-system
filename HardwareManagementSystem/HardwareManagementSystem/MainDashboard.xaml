            <Border Background="White" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="TxtSupplierModalTitle" Text="ADD NEW SUPPLIER" FontWeight="ExtraBold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HiddenSupplierFormID" Visibility="Collapsed"/>

                    <TextBlock Text="Supplier Name:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                    <TextBox x:Name="TxtQuickSupplierName" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Company Name:" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
