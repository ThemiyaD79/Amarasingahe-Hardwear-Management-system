<Window x:Class="HardwareManagementSystem.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Dashboard - Amarasinghe Hardware" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="A. Hardware" Foreground="#0EA5E9" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,10,0,30"/>
                <TextBlock Text="MAIN MENU" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="25,10,0,5"/>
                <Button Content="Home (Overview)" Style="{StaticResource SidebarButton}" x:Name="btnHomeNav" Click="btnHomeNav_Click"/>
                <Button Content="Sales History" Style="{StaticResource SidebarButton}" x:Name="btnSalesNav" Click="btnSalesNav_Click"/>
                <TextBlock Text="BUSINESS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="25,15,0,5"/>
                <Button Content="Debtors (Credit)" Style="{StaticResource SidebarButton}" x:Name="btnDebtorsNav" Click="btnDebtorsNav_Click"/>
                <Button Content="Inventory" Style="{StaticResource SidebarButton}" x:Name="btnInventoryNav" Click="btnInventoryNav_Click"/>
                <Button Content="Suppliers" Style="{StaticResource SidebarButton}" x:Name="btnSuppliersNav" Click="btnSuppliersNav_Click"/>
                <TextBlock Text="ADMINISTRATION" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="25,15,0,5"/>
                <Button Content="Staff Management" Style="{StaticResource SidebarButton}" x:Name="btnStaffNav" Click="btnStaffNav_Click"/>
                <Button Content="Reports" Style="{StaticResource SidebarButton}" x:Name="btnReportsNav" Click="btnReportsNav_Click"/>
                <Button Content="Settings" Style="{StaticResource SidebarButton}" x:Name="btnSettingsNav" Click="btnSettingsNav_Click"/>
                <Border Height="1" Background="#E2E8F0" Margin="20,15"/>
                <Button Content="Cashier Terminal" Style="{StaticResource SidebarButton}" x:Name="btnCashierNav" Click="btnCashierNav_Click" Foreground="#0EA5E9"/>
                <Button Content="Logout" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Margin="20,15,20,0" Padding="12" FontWeight="Bold" Cursor="Hand" Click="btnLogout_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid x:Name="TabOverview" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtWelcomeMessage" Text="Welcome Back, Manager!" Foreground="#0F172A" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Store Performance Overview" Foreground="#64748B" FontSize="16" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Padding="10">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="28"/>
                            <Border Background="#EF4444" CornerRadius="10" MinWidth="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0">
                                <TextBlock x:Name="TxtNotificationCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Total Accounts Payable" Style="{StaticResource CardTitle}" Foreground="#DC2626"/>
                            <TextBlock x:Name="TxtTotalPayable" Text="LKR 0.00" Style="{StaticResource CardValue}" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Total Physical Items in Stock" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="TxtTotalItems" Text="0" Style="{StaticResource CardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource DashboardCard}" Background="#FEF2F2" BorderBrush="#FECACA">
                        <StackPanel>
                            <TextBlock Text="Low Stock Alerts" Style="{StaticResource CardTitle}" Foreground="#DC2626"/>
                            <TextBlock x:Name="TxtLowStock" Text="0 Items" Style="{StaticResource CardValue}" Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Today's Total Revenue" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="TxtTodayRevenue" Text="LKR 0.00" Style="{StaticResource CardValue}" Foreground="#10B981"/>
                                <ProgressBar x:Name="ProgDailyGoal" Height="8" Margin="0,15,0,5" Foreground="#10B981" Background="#E2E8F0" BorderThickness="0"/>
                                <TextBlock x:Name="TxtGoalProgress" Text="0% of Daily Target" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,20,0,0" Padding="20">
                                <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Height="150">
                                    <Border Width="40" Height="80" Background="#BAE6FD" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="8,0"/>
                                    <Border Width="40" Height="120" Background="#3B82F6" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="8,0"/>
                                    <Border Width="40" Height="60" Background="#BAE6FD" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="8,0"/>
                                    <Border Width="40" Height="140" Background="#3B82F6" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="8,0"/>
                                    <Border Width="40" Height="90" Background="#BAE6FD" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" Margin="8,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Critical Low Stock Alerts" Style="{StaticResource CardTitle}" Foreground="#DC2626"/>
                                <TextBlock x:Name="TxtTotalTransactions" Visibility="Collapsed"/>
                            </Grid>

                            <DataGrid x:Name="DgdLowStock" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" IsReadOnly="True" RowHeight="35" Height="190" Margin="0,10,0,0">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Left" Binding="{Binding TotalQuantity}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Action" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Restock" Background="#3B82F6" Foreground="White" Padding="5,2" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenRestock_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="TabDebtors" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Debtor Management" FontWeight="ExtraBold" FontSize="32" Foreground="#0F172A"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdDebtors" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="45" Foreground="#334155">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding DebtorID}" Width="80"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                        <DataGridTextColumn Header="Outstanding Balance" Binding="{Binding TotalOutstandingAmount, StringFormat='LKR {0:N2}'}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Pay Now" Background="#10B981" Foreground="White" Padding="10,5" Margin="5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenSettleDebt_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabSales" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Sales History" FontWeight="ExtraBold" FontSize="32" Foreground="#0F172A"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Filter by Cashier:" VerticalAlignment="Center" Foreground="#64748B" FontWeight="Bold" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbStaffFilter" Width="150" Margin="0,0,20,0" Padding="5" SelectionChanged="CmbStaffFilter_SelectionChanged"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdSales" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="45" Foreground="#334155">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill ID" Binding="{Binding BillID}" Width="80"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                        <DataGridTextColumn Header="Cashier" Binding="{Binding StaffName}" Width="150"/>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentType}" Width="100"/>
                        <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, StringFormat='LKR {0:N2}'}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View Bill" Background="#3B82F6" Foreground="White" Padding="10,5" Margin="5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnViewBill_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabStaff" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="System Users" FontWeight="ExtraBold" FontSize="32" Foreground="#0F172A"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="+ Add New Staff" Background="#10B981" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnAddStaff_Click"/>
                        <Button Content="Update Selected" Background="#F59E0B" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnEditStaff_Click"/>
                        <Button Content="Delete Selected" Background="#EF4444" Foreground="White" Padding="15,10" Margin="0,0,20,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnDeleteStaff_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdStaff" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="45" Foreground="#334155">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StaffID}" Width="60"/>
                        <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="120"/>
                        <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="100"/>
                        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="120"/>
                        <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabInventory" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Inventory Items" FontWeight="ExtraBold" FontSize="32" Foreground="#0F172A"/>
                        <TextBlock Text="Manage products, pricing, and stock" Foreground="#64748B" FontSize="16" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="📥 Restock (Add Batch)" Background="#3B82F6" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenRestock_Click"/>
                        <Button Content="+ Add New Item" Background="#10B981" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnAddInventory_Click"/>
                        <Button Content="Update Selected" Background="#F59E0B" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnEditInventory_Click"/>
                        <Button Content="Delete Selected" Background="#EF4444" Foreground="White" Padding="15,10" Margin="0,0,20,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnDeleteInventory_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdInventory" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="45" Foreground="#334155">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductID}" Width="50"/>
                        <DataGridTemplateColumn Header="Pic" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ImagePath}" Height="30" Stretch="Uniform"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="Sub-Cat" Binding="{Binding SubCategory}" Width="100"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding SellingUnit}" Width="60"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding CurrentSellingPrice, StringFormat='LKR {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding TotalQuantity}" Width="60"/>
                        <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel}" Width="60"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabSuppliers" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Supplier Management" FontWeight="ExtraBold" FontSize="32" Foreground="#0F172A"/>
                        <TextBlock Text="Manage vendors and view supplied stock" Foreground="#64748B" FontSize="16" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="+ Add New Supplier" Background="#10B981" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnQuickAddSupplier_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgdSuppliers" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" IsReadOnly="True" RowHeight="45" Foreground="#334155">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding SupplierID}" Width="40"/>
                        <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="150"/>
                        <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingBalance, StringFormat='LKR {0:N2}'}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Action" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="View Stock" Background="#3B82F6" Foreground="White" Padding="10,5" Margin="5,5,2,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnViewSupplierStock_Click"/>
                                        <Button Content="Pay" Background="#10B981" Foreground="White" Padding="10,5" Margin="2,5,5,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnOpenSettleSupplier_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="TabReports" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Financial Reports" FontSize="32" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0" Foreground="#64748B"/>
                        <DatePicker x:Name="DpReportFrom" Width="120" Margin="0,0,15,0"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0" Foreground="#64748B"/>
                        <DatePicker x:Name="DpReportTo" Width="120" Margin="0,0,15,0"/>
