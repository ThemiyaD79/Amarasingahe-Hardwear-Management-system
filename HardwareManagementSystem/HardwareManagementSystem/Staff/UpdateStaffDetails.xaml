<Window x:Class="HardwareManagementSystem.UpdateStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Staff Details" Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1F2937"
        WindowStyle="ToolWindow">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="UPDATE STAFF DETAILS"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- FORM AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LEFT SIDE -->
            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Full Name:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName" Height="35" Background="#374151" Foreground="White"
                         BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Phone Number:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPhone" Height="35" Background="#374151" Foreground="White"
                         BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Username:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Height="35" Background="#374151" Foreground="White"
                         BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="Salary (Rs.):" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSalary" Height="35" Background="#374151" Foreground="White"
                         BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,0,15">
                <TextBlock Text="Age:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAge" Height="35" Background="#374151" Foreground="White"
                         BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- RIGHT SIDE -->
            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="NIC Number:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNIC" Height="35" Background="#374151" Foreground="White"
                         BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="System Role:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbRole" Height="35" Background="#374151" Foreground="White"
                          BorderThickness="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Manager"/>
                    <ComboBoxItem Content="Cashier"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Password:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Background="#374151" Foreground="White"
                             BorderThickness="0" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="(Leave blank to keep current password)" Foreground="#9CA3AF" FontSize="11" Margin="5,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="Starting Date:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpStartingDate" Height="35" Background="#374151" Foreground="White"
                            BorderThickness="0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="4" Margin="0,0,0,15">
                <TextBlock Text="Account Status:" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                <CheckBox x:Name="chkIsActive" Content="Is Active" Foreground="White" VerticalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="40" Background="#4B5563" Foreground="White"
                    BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="btnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="btnUpdate" Content="Save Staff" Width="120" Height="40" Background="#10B981" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnUpdate_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>