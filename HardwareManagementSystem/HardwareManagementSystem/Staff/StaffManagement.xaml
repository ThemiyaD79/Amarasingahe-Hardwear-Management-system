<Window x:Class="HardwareManagementSystem.StaffManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Management" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Window.Resources>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1F2937"/>
            <Setter Property="AlternatingRowBackground" Value="#374151"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="Height" Value="45"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Back + Header -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons + Search -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- BACK BUTTON + HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <Button x:Name="btnBack"
                    Content="← Back"
                    Width="100"
                    Height="35"
                    Background="#6B7280"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnBack_Click"
                    Margin="0,0,0,10"/>

            <TextBlock Text="MANAGEMENT / STAFF"
                       Foreground="#9CA3AF"
                       FontSize="12"
                       FontWeight="Bold"/>
            <TextBlock Text="System Users"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Buttons + Search -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnAddStaff" Content="+ Add New Staff" Width="150" Height="40"
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,10,0" Click="btnAddStaff_Click"/>

                <Button x:Name="btnUpdateStaff" Content="Update Selected" Width="150" Height="40"
                        Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,10,0" Click="btnUpdateStaff_Click"/>

                <Button x:Name="btnDeleteStaff" Content="Delete Selected" Width="150" Height="40"
                        Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,10,0" Click="btnDeleteStaff_Click"/>

                <Button x:Name="btnViewAll" Content="View All" Width="120" Height="40"
                        Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="btnViewAll_Click"/>
            </StackPanel>

            <TextBox x:Name="txtSearch" Grid.Column="2" Width="250" Height="40"
                     Background="#374151" Foreground="White" FontSize="14" BorderThickness="0"
                     VerticalContentAlignment="Center" Padding="15,0,0,0"/>

            <Button x:Name="btnSearch" Grid.Column="3" Content="Search" Width="90" Height="40"
                    Background="#6B7280" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="10,0,0,0" Click="btnSearch_Click"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgStaff" Grid.Row="2"
                  Style="{StaticResource ModernDataGrid}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding StaffID}" Width="60"/>
                <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="1.5*"/>
                <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="1.5*"/>
                <DataGridTextColumn Header="NIC" Binding="{Binding NIC}" Width="1.5*"/>
                <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="1.5*"/>
                <DataGridTextColumn Header="START DATE" Binding="{Binding StartingDate, StringFormat=yyyy-MM-dd}" Width="1.5*"/>
                <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>