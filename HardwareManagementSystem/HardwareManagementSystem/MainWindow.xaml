<Window x:Class="HardwareManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amarasinghe Hardware - Login" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2C3E50" Offset="0.0"/>
            <GradientStop Color="#4CA1AF" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <TextBlock Text="AMARASINGHE HARDWARE" 
                   Foreground="White" FontSize="36" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,50,0,0"
                   FontFamily="Segoe UI" VerticalAlignment="Top"/>

        <Border Width="400" Height="460" 
                Background="#CC111111" 
                CornerRadius="15" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="0,60,0,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel Margin="35">

                <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,30">
                    <TextBlock Text="Login Here" FontSize="22" FontWeight="Bold" 
                               Foreground="Black" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Enter username" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Height="40" FontSize="15" 
                         Background="#F0F8FF" BorderThickness="0" 
                         VerticalContentAlignment="Center" Padding="10,0,0,0" Margin="0,0,0,20"/>

                <TextBlock Text="Enter Password Here" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="txtPassword" Height="40" FontSize="15" 
                                 Background="#F0F8FF" BorderThickness="0" 
                                 VerticalContentAlignment="Center" Padding="10,0,0,0" PasswordChanged="txtPassword_PasswordChanged"/>
                    <TextBox x:Name="txtPasswordVisible" Height="40" FontSize="15" 
                             Background="#F0F8FF" BorderThickness="0" 
                             VerticalContentAlignment="Center" Padding="10,0,0,0" Visibility="Collapsed" TextChanged="txtPasswordVisible_TextChanged"/>
                </Grid>

                <CheckBox x:Name="chkShowPassword" Content="Show Password" 
                          Foreground="White" FontSize="13" Margin="0,0,0,30" Cursor="Hand" Click="chkShowPassword_Click"/>

                <Button x:Name="btnLogin" Content="Login" Height="45" FontSize="18" 
                        FontWeight="Bold" Foreground="White" Background="#F59E0B" 
                        BorderThickness="0" Cursor="Hand" Click="btnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <TextBlock Text="Forget your password? " Foreground="#CCCCCC" FontSize="13"/>
                    <TextBlock Text="Reset from here" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>